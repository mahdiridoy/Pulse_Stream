# Backend
HOST=0.0.0.0
PORT=8080
FRONTEND_URL=http://localhost:3000
RUST_LOG=info

# Database
DATABASE_URL=postgres://pulse:pulse_secret@localhost:5432/pulse_stream

# Auth
JWT_SECRET=change-this-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redis (optional)
REDIS_URL=

# Security
POSTGRES_PASSWORD=pulse_secret

# Proxy (set to true behind a reverse proxy that sets X-Forwarded-For)
TRUST_PROXY=false
# Comma-separated list of trusted proxy IPs (empty = trust all peers when TRUST_PROXY=true)
TRUSTED_PROXY_IPS=
